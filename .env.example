PORT=8080
VITE_API_URL="http://localhost:${PORT}/api"

# Needed only for `docker compose build`: Compose interpolates the web
# service's build args from THIS file (or the shell env), not from
# client/web-app/.env. Leave blank to build without Maps/analytics.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GA_TRACKING_ID=