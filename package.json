{
  "name": "EVAT-Website",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for the Electric Vehicle Application Tool (EVAT)",
  "workspaces": [
    "client/web-app",
    "server/node-api"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "npx concurrently -c \"#93c5fd,#c4b5fd\" \"npm run dev:client\" \"npm run dev:server\" --names=client,server --kill-others",
    "dev:client": "npm run dev --workspace=client/web-app",
    "dev:server": "npm run server --workspace=server/node-api",
    "build:client": "npm run build --workspace=client/web-app",
    "build:server": "npm run build --workspace=server/node-api",
    "test:client": "npm run test --workspace=client/web-app",
    "test:server": "npm run test --workspace=server/node-api"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
