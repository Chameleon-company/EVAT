DOMAIN_URL=

MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=

JWT_SECRET=

GOOGLE_MAPS_API_KEY=
GOOGLE_AI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS="./google-credentials.json"

EMAIL_USER="sender@example.com"
EMAIL_PASS=

ADMIN_EMAIL="admin@example.com"

# Port the Node API listens on (defaults to 8080)
PORT=8080

# Combined Python ML service.
#   local dev : http://127.0.0.1:5000
#   docker    : http://pythonsvc:5000   (set by docker-compose.yml)
PYTHON_API_URL=http://127.0.0.1:5000

# Optional dedicated endpoints for the cost-comparison and demand-forecasting APIs.
# Left blank for fallback to PYTHON_API_URL as docker-compose.yml overrides PYTHON_API_URL, so setting these would bypass that override in Docker.
COST_API_URL=
DEMAND_API_URL=

# Reliability scoring FastAPI (separate uvicorn app, not yet containerised)
RELIABILITY_API_URL=http://127.0.0.1:8003
