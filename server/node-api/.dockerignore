# Never ship host build artefacts or secrets into the image.
node_modules
npm-debug.log*

# Secrets / credentials - these must come from Compose at runtime.
.env
.env.*
!.env.example
*credentials*.json
*credintials*.json

# Not needed to build or run the API image.
test
jest.config.js
build
dist
*.md
.git
.DS_Store
